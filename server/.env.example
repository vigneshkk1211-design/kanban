# ─────────────────────────────────────────────────────────────────────────────
# Kanban Board — Server Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Server port
PORT=5000

# ── MongoDB URI ───────────────────────────────────────────────────────────────
# Option 1: Local MongoDB (use 127.0.0.1 NOT localhost — fixes Node.js 18+ IPv6 issue)
MONGO_URI=mongodb://127.0.0.1:27017/kanban

# Option 2: MongoDB Atlas (replace the placeholder below with your actual URI)
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/kanban?retryWrites=true&w=majority

# ── CORS Origin ───────────────────────────────────────────────────────────────
# URL of your React frontend
CLIENT_ORIGIN=http://localhost:5173
